  "version": "4C.6-H13",
  "status_definitions": {
    "implemented": "Exposed and mechanically enforced for the current supported level/scope.",
    "partial": "Exposed and partially enforced, but missing at least one meaningful rules interaction.",
    "deferred": "Exposed or planned in text/data, but intentionally not yet runtime-enforced.",
    "not_exposed": "Tracked for future completeness, but not currently exposed to public play."
  },
  "actions": {
    "attack": { "status": "implemented", "implementation": "Server-owned combat attack resolution spends the Action while leaving the rest of the player turn available." },
    "dash": { "status": "implemented", "implementation": "Dash spends an Action and grants extra movement equal to Speed for the current turn." },
    "disengage": { "status": "implemented", "implementation": "Disengage spends an Action and suppresses Opportunity Attacks for the rest of the current turn." },
    "dodge": { "status": "implemented", "implementation": "Dodge can impose disadvantage on creature attacks." },
    "grapple": { "status": "implemented", "implementation": "Grapple uses Attack action option and target save." },
    "help": { "status": "partial", "implementation": "Recognized as an action, but advantage handoff is incomplete." },
    "hide": { "status": "partial", "implementation": "Prompts Stealth checks, but full hidden/visibility state is incomplete." },
    "influence": { "status": "partial", "implementation": "Prompts social checks, but NPC attitude state is incomplete." },
    "magic": { "status": "partial", "implementation": "Spell casting includes a server-owned attack-hit Reaction window for Shield; additional Reaction spells and trigger families remain incomplete." },
    "ready": { "status": "deferred", "implementation": "Recognized as a future combat action." },
    "search": { "status": "partial", "implementation": "Prompts Perception checks, but target/entity search state is incomplete." },
    "shove": { "status": "implemented", "implementation": "Shove uses Attack action option and target save." },
    "study": { "status": "partial", "implementation": "Prompts Investigation/Insight-style checks, but object/NPC knowledge state is incomplete." },
    "utilize": { "status": "partial", "implementation": "Object interaction exists through narration/spatial guard, not full item rules." },
    "opportunity_attack": { "status": "partial", "implementation": "Enemy melee reactions resolve before the active player leaves reach, including resumable Shield windows; player Opportunity Attacks against future creature movement remain deferred." },
    "object_interaction": { "status": "partial", "implementation": "Spatial guard checks presence; item/object state is not complete." }
